# Copy to .env for local runs. docker-compose sets its own values.
DATABASE_URL=sqlite:///./hiresignal.db
# Celery broker + shared rate limiter. Leave empty and set CELERY_ALWAYS_EAGER=true to run
# scans inline in the API process (no worker needed)
REDIS_URL=
CELERY_ALWAYS_EAGER=true
APP_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173
PUBLIC_URL=http://localhost:5173

TIMEZONE=Asia/Kolkata
SCAN_HOUR=2
DIGEST_HOUR=8
DIGEST_TO=

# Any OpenAI-compatible endpoint. Without a key, headlines are classified by keywords
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
